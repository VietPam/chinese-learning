    "duration": 2.275
  },
  "p21": {
    "text": "好啊，那你注意安全。",
    "src": "/audio/p21-1ddde67e2ecaf056.mp3",
    "sha256": "8be42c7296060139b81fbf1985cbbb3c67128fe398337c37450fd7b90d5f8026",
    "duration": 3.0
  },
  "p22": {
