  "p01": {
    "text": "你在忙吗？",
    "src": "/audio/p01-3355fa0dd310d0bf.mp3",
    "sha256": "d673106d275fefc3b419c84dc4b627718b97a3acdf533ea295215893b3924c90",
    "duration": 2.05
  },
  "p02": {
    "text": "你在工作吗？",
    "src": "/audio/p02-06f6e96fcf40163d.mp3",
    "sha256": "ab76b1317c0c81998932d39698add53777e1154eb6923fb175cb97795b07825e",
    "duration": 2.225
  },
  "p03": {
    "text": "你在家吗？",
    "src": "/audio/p03-3b4d4b13c7d55f6a.mp3",
    "sha256": "1baeb45288360730bacfdab6546acb8f52e79d5395a8f531572844afa9e3bf70",
    "duration": 2.0
  },
  "p04": {
    "text": "你在吃饭吗？",
    "src": "/audio/p04-5a5484b6e7b74907.mp3",
    "sha256": "5d1e200ef3303d2da4e0282f10234ef2299b54b1cb2291d9d1a5baf8368f8c0e",
    "duration": 2.275
  },
  "p05": {
    "text": "你吃饭了吗？",
    "src": "/audio/p05-e29238339c9fe7ec.mp3",
    "sha256": "deaf7212bb717610d746c315e94951ca57204f7602b01196411b77770ba2ca57",
    "duration": 2.125
  },
  "p06": {
    "text": "你到家了吗？",
    "src": "/audio/p06-c54e2529536d7bec.mp3",
    "sha256": "0f2db2e31720712d014f59c97b7109d4ca1860fe786d8ffeb1a6ea2b9679b089",
    "duration": 2.075
  },
  "p07": {
    "text": "你下班了吗？",
    "src": "/audio/p07-78b9b7095c90aaa0.mp3",
    "sha256": "cb2e252bab03864e5d0b46c296ead0aad36125d918735e761be013a18031f9e0",
    "duration": 2.125
  },
  "p08": {
    "text": "你累吗？",
    "src": "/audio/p08-8137eddda36d979b.mp3",
    "sha256": "c1450e5025ee8ce4a5606e05bce40e6568067113e89aaf6a2e3e9bf9f37fded8",
    "duration": 1.7
  },
  "p09": {
    "text": "你饿吗？",
    "src": "/audio/p09-97dcee8a23f36c31.mp3",
    "sha256": "e86699a9c7ccdf8880ad57eb941c2bed308c49c421e06b9f738072452390fff5",
    "duration": 1.675
  },
  "p10": {
    "text": "你想我吗？",
    "src": "/audio/p10-c2ffd3f7203b9a9b.mp3",
    "sha256": "14150dc2a0820beb5a93024ac4d52ab74912bd3284edd0466e94afd491cf602e",
    "duration": 2.075
  },
  "p11": {
    "text": "我在去上班的路上。",
    "src": "/audio/p11-ce5c093990cea11d.mp3",
    "sha256": "3b65730af65c31fef36dae408a7ec98e8f104ebb40377bcb198483f34c3fdfd8",
    "duration": 3.025
  },
  "p12": {
    "text": "我在工作。",
    "src": "/audio/p12-2d092dd9a1089c7a.mp3",
    "sha256": "e1a0f2be1e8ae9a1903ab28b8e465b6787c0c9c872488af705f53a948be099d0",
    "duration": 2.075
  },
  "p13": {
    "text": "我在回家的路上。",
    "src": "/audio/p13-10d44a3b12a9a64e.mp3",
    "sha256": "fd8b4992298704ed14da9f81423debe075c151737bdb3280b843964b43931640",
    "duration": 2.7
  },
  "p14": {
    "text": "我在吃饭。",
    "src": "/audio/p14-bd9a2375346829bd.mp3",
    "sha256": "b470c2265adf2580ad25ca12efc18b30f4a1c4128ca58bf7effe8de3f0fdfe1f",
    "duration": 2.075
  },
  "p15": {
    "text": "我在忙。",
    "src": "/audio/p15-9a4ba392bf56c902.mp3",
    "sha256": "09f9b652bc8583acaccb075071cf288a1001edae5f5198ac8679df605da29e15",
    "duration": 1.8
  },
  "p16": {
    "text": "我到家了。",
    "src": "/audio/p16-08bdd37abe828e41.mp3",
    "sha256": "d6e8be6f610c108ee135ed6a59b004eb53d52a516eb31120aff0646318b89b2b",
    "duration": 2.05
  },
  "p17": {
    "text": "我下班了。",
    "src": "/audio/p17-e64e0b5a942890e1.mp3",
    "sha256": "5713847658b4c675ef9ed38715014adbe84d37d181b760d88e63c90e7e967115",
    "duration": 2.025
  },
  "p18": {
    "text": "我吃饭了。",
    "src": "/audio/p18-0f3fae1273ea44a4.mp3",
    "sha256": "8ab8124b82412f3c83771fee6da1a225049d6e7fd6ac826ec0b112e13a000535",
    "duration": 2.075
  },
  "p19": {
    "text": "我想你。",
    "src": "/audio/p19-5c1295fc2a788958.mp3",
    "sha256": "01551f8fb487153e2c5ba90f099c318ce9f49d3591a96b2536d2345b76f9ae23",
    "duration": 1.825
  },
  "p20": {
    "text": "我去睡觉了。",
    "src": "/audio/p20-da4f0e8cf3e69087.mp3",
